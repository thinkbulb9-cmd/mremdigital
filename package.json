{
  "name": "mrem-digital-library-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "db:init": "node --env-file=.env.local scripts/init-db.mjs",
    "storage:add": "node --env-file=.env.local scripts/register-storage.mjs",
    "storage:check": "node --env-file=.env.local scripts/storage-check.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "scan": "node --env-file=.env.local scripts/scan.mjs",
    "typecheck": "tsc --noEmit",
    "mac:video-test": "bash scripts/mac-video-test.sh",
    "test:stream": "node --experimental-strip-types --test scripts/test-range-stream.mjs",
    "staff:setup": "node --env-file=.env.local scripts/staff-setup.mjs",
    "mappings:apply": "node --env-file=.env.local scripts/apply-mappings.mjs",
    "campus:scan": "node --env-file=.env.local scripts/scan-full-drive.mjs",
    "campus:metadata": "node --env-file=.env.local scripts/import-course-catalog.mjs",
    "campus:export": "node --env-file=.env.local scripts/export-full-inventory.mjs",
    "campus:departments": "node --env-file=.env.local scripts/map-nptel-departments.mjs",
    "campus:audit": "node --env-file=.env.local scripts/audit-campus-index.mjs",
    "campus:publish": "node --env-file=.env.local scripts/publish-course.mjs",
    "campus:review:export": "node --env-file=.env.local scripts/export-course-hod-review.mjs",
    "campus:review:import": "node --env-file=.env.local scripts/import-course-hod-review.mjs",
    "campus:repeats": "node --env-file=.env.local scripts/export-possible-repeats.mjs",
    "campus:html:extract": "node --env-file=.env.local scripts/extract-legacy-html-for-github.mjs",
    "campus:legacy": "node --env-file=.env.local scripts/legacy-catalogue/run.mjs",
    "test:legacy": "node --test scripts/legacy-catalogue/test.mjs",
    "test:nptel": "node --test scripts/nptel-reconciliation/test.mjs",
    "nptel:fetch": "node --env-file=.env.local scripts/nptel-reconciliation/fetch-official.mjs",
    "nptel:reconcile": "node --env-file=.env.local scripts/nptel-reconciliation/reconcile.mjs",
    "nptel:workbook": "node scripts/nptel-reconciliation/workbook.mjs",
    "nptel:official-titles": "node --env-file=.env.local scripts/nptel-reconciliation/apply-official-titles.mjs",
    "nptel:lecture-titles": "node --env-file=.env.local scripts/nptel-reconciliation/import-lecture-titles.mjs",
    "campus:reports": "node --env-file=.env.local scripts/nptel-reconciliation/drive-reports.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pg": "^8.16.3",
    "server-only": "0.0.1",
    "lucide-react": "^0.468.0",
    "cheerio": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
